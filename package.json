    "prepare": "npm run build"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "purs-backend-es": "^1.4.3"
  },
  "devDependencies": {
    "purescript": "0.15.16",
    "spago": "1.0.4"
  }
}
