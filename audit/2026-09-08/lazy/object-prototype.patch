+-- Store immutable captures in object fields instead of a Closure's hash table.
+-- Reload locals on each invocation, just like PHP's by-value `use` bindings.
+-- The body retains the same overapplication protocol as the unary closure.
+genUnaryCallable :: String -> Array String -> String -> String
+genUnaryCallable argStr captures fnBody =
+  let
+    names = map (\name -> "$" <> safeName name) captures
+    fields = mapWithIndex (\i _ -> "__capture" <> show i) captures
+    declarations = joinWith "\n" (map (\field -> "  private $" <> field <> ";") fields)
+    initialize = joinWith "\n" (mapWithIndex (\i name -> "    $this->" <> ("__capture" <> show i) <> " = " <> name <> ";") names)
+    reload = joinWith "\n" (mapWithIndex (\i name -> "  " <> name <> " = $this->__capture" <> show i <> ";") names)
+  in
+    "new class(" <> joinWith ", " names <> ") {\n" <>
+    declarations <> "\n" <>
+    "  public function __construct(" <> joinWith ", " names <> ") {\n" <> initialize <> "\n  }\n" <>
+    "  public function __invoke(" <> argStr <> ") {\n" <> reload <> "\n" <> fnBody <> "  }\n}"
+
