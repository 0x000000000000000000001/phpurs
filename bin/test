#!/usr/bin/env bash
set -euo pipefail

# Compile and execute the vendored language fixtures in a disposable project.
ROOT_DIR=$(cd "$(dirname "$0")/.." && pwd)
PASSING_DIR="$ROOT_DIR/tests/passing"
RUNNER_DIR="$ROOT_DIR/tests/runner"
source "$ROOT_DIR/bin/pkg"

# These fixtures require newer compiler features or different PHP semantics.
EXCLUDED_TESTS=(
  DerivingClause.purs DerivingContravariant.purs DerivingFunctorFromBi.purs
  DerivingFunctorFromPro.purs DerivingProfunctor.purs
  2136.purs # PHP integers use the platform width, not signed 32-bit overflow.
  4179.purs # PHP lazy loading does not report cyclic InitializationError.
)
TEST_FILES=()
CLEAN_CACHE=0
SKIP_BEFORE=""

usage() {
  cat <<'HELP'
Usage: bin/test [fixture.purs|fixture|path ...] [--skip-before=fixture] [-c|--clean]

With no fixtures, run every passing fixture except the documented exclusions.
--skip-before starts at the named fixture within the selected files.
--clean rebuilds phpurs and clears the runner caches before testing.
HELP
}

fail() {
  printf '[ERROR] %s\n' "$*" >&2
  exit 1
}

add_test_file() {
  local argument="$1" candidate
  for candidate in "$ROOT_DIR/$argument" "$argument" "$PASSING_DIR/$argument" "$PASSING_DIR/$argument.purs"; do
    if [[ -f "$candidate" ]]; then
      [[ "$candidate" == *.purs ]] || fail "Expected a .purs fixture: $argument"
      # Resolve relative paths before changing into the runner project.
      TEST_FILES+=("$(cd "$(dirname "$candidate")" && pwd)/$(basename "$candidate")")
      return
    fi
  done
  fail "Test file $argument not found."
}

parse_arguments() {
  local argument
  for argument in "$@"; do
    case "$argument" in
      --skip-before=*|skip_before=*)
        SKIP_BEFORE="${argument#*=}"
        [[ -n "$SKIP_BEFORE" ]] || fail "--skip-before requires a fixture name."
        ;;
      -c|--clean) CLEAN_CACHE=1 ;;
      -h|--help) usage; exit 0 ;;
      -*) fail "Unknown option: $argument" ;;
      *) add_test_file "$argument" ;;
    esac
  done
}

select_test_files() {
  if [[ ${#TEST_FILES[@]} -eq 0 ]]; then
    shopt -s nullglob
    TEST_FILES=("$PASSING_DIR"/*.purs)
    shopt -u nullglob
  fi
  [[ ${#TEST_FILES[@]} -gt 0 ]] || fail "No passing fixtures found in $PASSING_DIR."

  if [[ -n "$SKIP_BEFORE" ]]; then
    local file name found=0
    local selected=()
    for file in "${TEST_FILES[@]}"; do
      name=$(basename "$file")
      if [[ "$name" == "$SKIP_BEFORE" || "$name" == "$SKIP_BEFORE.purs" ]]; then
        found=1
      fi
      if [[ $found -eq 1 ]]; then selected+=("$file"); fi
    done
    [[ $found -eq 1 ]] || fail "Start fixture $SKIP_BEFORE is not in the selected tests."
    TEST_FILES=("${selected[@]}")
  fi
}

require_packages() {
  local package
  for package in "${CORE_PACKAGES[@]}"; do
    [[ -d "$ROOT_DIR/../phpurs-$package" ]] ||
      fail "Missing sibling checkout: phpurs-$package. Run ./bin/setup first."
  done
}

prepare_runner() {
  mkdir -p "$RUNNER_DIR/src"
  if [[ ! -f "$RUNNER_DIR/spago.yaml" ]]; then
    local package
    {
      printf 'package:\n  name: runner\n  dependencies:\n'
      for package in "${CORE_PACKAGES[@]}"; do printf '    - %s\n' "$package"; done
      printf 'workspace:\n  packageSet:\n    registry: 77.10.1\n  extraPackages:\n'
      for package in "${CORE_PACKAGES[@]}"; do
        printf '    %s:\n      path: "../../../phpurs-%s"\n' "$package" "$package"
      done
    } > "$RUNNER_DIR/spago.yaml"
  fi

  if [[ $CLEAN_CACHE -eq 1 ]]; then
    printf 'Building phpurs compiler...\n'
    (cd "$ROOT_DIR" && npm run build --silent) || fail "phpurs build failed."
    printf '=> Cleaning Spago and output cache...\n'
    rm -rf "$RUNNER_DIR/.spago" "$RUNNER_DIR/output-es" "$RUNNER_DIR/output" "$RUNNER_DIR/output-test"
  fi
}

is_excluded() {
  local excluded
  for excluded in "${EXCLUDED_TESTS[@]}"; do
    if [[ "$1" == "$excluded" ]]; then return 0; fi
  done
  return 1
}

prepare_fixture() {
  local file="$1" extension
  rm -rf output-test/Main src
  mkdir -p src
  cp "$file" src/Main.purs
  # Ensure the compiler observes each newly copied fixture despite equal mtimes.
  printf '\n-- runner invocation %s-%s\n' "$$" "$RANDOM" >> src/Main.purs
  for extension in js php; do
    if [[ -f "${file%.purs}.$extension" ]]; then
      cp "${file%.purs}.$extension" "src/Main.$extension"
    fi
  done
  if [[ -d "${file%.purs}" ]]; then cp -R "${file%.purs}/." src/; fi
}

run_fixture() {
  local output
  if ! output=$(spago build -q --output output-test 2>&1); then
    printf '[FAILED] PureScript compilation\n%s\n' "$output" >&2
    return 1
  fi
  if ! output=$("$ROOT_DIR/bin/phpurs" --output output-test 2>&1); then
    printf '[FAILED] PHP generation\n%s\n' "$output" >&2
    return 1
  fi
  if ! output=$(php -d memory_limit=512M -d opcache.enable_cli=0 output-test/Main/main.mod.php 2>&1); then
    printf '[FAILED] PHP execution\n%s\n' "$output" >&2
    return 1
  fi
  if [[ -n "$output" ]]; then printf '%s\n' "$output"; fi
  if [[ "$output" == *Fail* ]]; then
    printf '[FAILED] Fixture reported failure\n' >&2
    return 1
  fi
  printf '   [OK]\n'
}

main() {
  parse_arguments "$@"
  select_test_files
  require_packages
  prepare_runner
  cd "$RUNNER_DIR"

  local file name passed=0 failed=0 skipped=0
  printf 'Running tests from %s...\n' "$PASSING_DIR"
  for file in "${TEST_FILES[@]}"; do
    name=$(basename "$file")
    if is_excluded "$name"; then
      printf '=> Skipping %s (excluded)\n' "$name"
      skipped=$((skipped + 1))
      continue
    fi
    printf '=> Testing %s\n' "$name"
    prepare_fixture "$file"
    if run_fixture; then
      passed=$((passed + 1))
    else
      failed=$((failed + 1))
      break
    fi
  done
  printf '\nSummary: %s passed, %s failed, %s skipped.\n' "$passed" "$failed" "$skipped"
  [[ $failed -eq 0 ]]
}

main "$@"
